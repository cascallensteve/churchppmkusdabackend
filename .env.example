SECRET_KEY=change-me-in-production
DEBUG=True

# Local development: leave DATABASE_URL unset to use SQLite
# Production (Neon): set DATABASE_URL from your Neon dashboard
# DATABASE_URL=postgres://user:password@host:port/database

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173

# Email settings
# Local development: console backend prints emails to terminal
# Production: configure SMTP settings below
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MKUSD Treasury <noreply@mkusda.church>

# M-Pesa Daraja Settings
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
